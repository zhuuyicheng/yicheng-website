    {
      "type": "state-timeline",
      "id": 20,
      "title": "Who answers Prometheus",
      "description": "Every process Prometheus reads, every 15 s: up answers, down doesn't (stopped, restarting, or a wrong METRICS_TOKEN). A deploy shows a short blip per replica; 2 minutes down is TargetDown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
