# HTTPS, path routing and load balancing for the production stack (DESIGN.md §14.5).
# Reload without downtime:
#   docker compose -f deploy/compose.prod.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
#
#   https://<host>/api/*      →  api-1 / api-2   (round robin, health-checked)
#   https://<host>/grafana/*  →  grafana         (its own login, DESIGN.md §15.4)
#   https://<host>/*          →  web
#   while deploy/caddy/paused exists: the "back soon" page (docs/CD.md §5)
#
# {$SITE_HOST} comes from deploy/.env, so the hostname is never in Git. For `localhost` Caddy
# makes its own certificate, which browsers warn about.

# The two API replicas, used by both sites below.
(api_replicas) {
	reverse_proxy api-1:4000 api-2:4000 {
		lb_policy round_robin
		# Connection refused (stopped, restarting): retry on the other replica for up to 5 s.
		lb_try_duration 5s
		# GET /health/live every 5 s; a failing replica is skipped until it answers. Not /health,
		# which fails on both at once when a datastore is down. A rolling update waits 6 s after a
		# new replica is healthy, so Caddy has seen it before the other is replaced.
		health_uri /health/live
		health_interval 5s
		health_timeout 2s
		transport http {
			# During a rolling update, looking up a removed container's name can hang for seconds.
			# Give up after 1 s, leaving time to retry elsewhere.
			dial_timeout 1s
		}
	}
}

{$SITE_HOST} {
	# Paused (docs/CD.md §5): while deploy/caddy/paused exists, visitors get back-soon.html.
	# Checked on every request, so no reload needed. /admin (and its /_next/ files) and Grafana
	# stay open.
	@paused {
		file {
			root /etc/caddy
			try_files /paused
		}
		not path /admin /admin/* /_next/* /grafana /grafana/*
	}
	handle @paused {
		# 503 + Retry-After: search engines see the pause as temporary.
		header Retry-After 3600
		header Cache-Control no-store
		root * /etc/caddy
		rewrite * /back-soon.html
		file_server {
			status 503
		}
	}

	# Not paused. Nested so the check above comes first: otherwise Caddy would sort path
	# handles (/api/*) before it.
	handle {
		# For the web server only (via :8080 below); they need the admin token anyway.
		handle /api/v1/admin/* {
			respond 404
		}
		handle /api/* {
			import api_replicas
		}
		# The prefix stays: Grafana serves from /grafana (GF_SERVER_SERVE_FROM_SUB_PATH).
		@grafana path /grafana /grafana/*
		handle @grafana {
			reverse_proxy grafana:3000
		}
		handle {
			reverse_proxy web:3000
		}
	}
}

# Unpublished: the web server's own API calls (API_BASE_URL=http://caddy:8080), balanced the
# same way, without leaving the server or paying for TLS.
:8080 {
	import api_replicas
}
