# Settings for deploy/compose.prod.yml. Copy to deploy/.env (ignored by Git) and fill it in.
# On the server it holds the real secrets: keep a copy in your password manager.
# Guide: docs/PRODUCTION-STACK.md. Secrets: openssl rand -hex 32 (hex is safe in the DB URL)

# Hostname, without https://: `localhost` on your laptop, the real name on the server. Same as
# SITE_HOST in GitHub's production environment (docs/CD.md §2).
SITE_HOST=localhost

# Postgres. The password stays inside the server's private Docker network.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# API secrets (DESIGN.md §4): at least 32 characters each (METRICS_TOKEN: 16).
IP_HASH_SECRET=
METRICS_TOKEN=
# The /admin password, also the web server's token for the owner's API routes.
ADMIN_TOKEN=

# Notifications and alerts: `discord` on the server; `log` on your laptop, so tests never post.
NOTIFIER_DRIVER=log
DISCORD_WEBHOOK_URL=

# Grafana's password (https://<host>/grafana, user `admin`): openssl rand -hex 24. Read only on
# Grafana's first start (DESIGN.md §15.4); changing it later: docs/PRODUCTION-STACK.md §7.
GRAFANA_ADMIN_PASSWORD=

# LOG_LEVEL=info

# Which images to run. Unset: the ones built here (npm run image:api / image:web). Left to
# deploy/deploy.sh, which writes the release it deployed (docs/CD.md).
# API_IMAGE=
# WEB_IMAGE=
