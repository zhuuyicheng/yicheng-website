# The production stack's settings (deploy/compose.prod.yml). Copy to deploy/.env, which Git
# ignores, and fill it in. On the server this file holds the real secrets: keep a copy in your
# password manager (DESIGN.md §14.4). Guide: docs/PRODUCTION-STACK.md
#
# Make each secret with:  openssl rand -hex 32
# (hex: letters and digits only, so the database password is safe inside a URL)

# The site's hostname, without https://. `localhost` on your laptop; on the server the
# DuckDNS name (yourname.duckdns.org), later yourname.is-a.dev.
SITE_HOST=localhost

# Postgres. The password is only used inside the server's private Docker network.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# API secrets (DESIGN.md §4). Each at least 32 characters (METRICS_TOKEN: 16).
IP_HASH_SECRET=
METRICS_TOKEN=
# The /admin password, also the web server's token for the owner's API routes.
ADMIN_TOKEN=

# Contact-form notifications: `discord` on the server; `log` on your laptop, so trying the
# stack never posts to your real channel.
NOTIFIER_DRIVER=log
DISCORD_WEBHOOK_URL=

# LOG_LEVEL=info

# Which images to run. Unset: the ones built on this machine (npm run image:api / image:web).
# The deploy (6c) sets them to the released versions, e.g. ghcr.io/<owner>/portfolio-api:<sha>.
# API_IMAGE=
# WEB_IMAGE=
