{
  "name": "portfolio-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @portfolio/api",
    "dev:worker": "npm run dev:worker -w @portfolio/api",
    "dev:web": "npm run dev -w @portfolio/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit -w @portfolio/api",
    "test:integration": "npm run test:integration -w @portfolio/api",
    "db:migrate": "npm run db:migrate -w @portfolio/api",
    "content:seed": "npm run content:seed -w @portfolio/api",
    "dlq:replay": "npm run dlq:replay -w @portfolio/api --",
    "geoip:download": "npm run geoip:download -w @portfolio/api",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
