# Read by `next dev` only (never by `next build` or `next start`). Development values, the
# same as the root .env.example: production sets its own in the server's env file.
#
# The owner's password for /admin (any username); must match ADMIN_TOKEN in the root .env,
# because the web server also sends it to the API's /api/v1/admin/* endpoints.
ADMIN_TOKEN=local-dev-only-admin-token-change-me-in-production
