# Copy to .env for local development:  cp .env.example .env
# Every variable is documented in DESIGN.md §4.

# --- Docker Compose (local Postgres + Redis) ----------------------------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API -----------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0
SHUTDOWN_TIMEOUT_MS=10000

# --- Content cache (Phase 2) -----------------------------------------------------
CACHE_TTL_SECONDS=300

# --- Telemetry (Phase 3) -----------------------------------------------------------
# true only behind a reverse proxy (Caddy in production), so request.ip is the visitor's IP.
TRUST_PROXY=false
# POST /api/v1/events answers 503 once this many events are waiting in Redis.
TELEMETRY_BUFFER_MAX_LENGTH=100000
# Worker (npm run dev:worker): events per INSERT, and the pause when the buffer is empty.
TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_INTERVAL_MS=5000
# IP → organisation and country/city. Run `npm run geoip:download` first (free DB-IP Lite
# files, ~140 MB of RAM in the API). Remove these two lines to turn the lookup off.
GEOIP_ASN_DB_PATH=data/geoip/dbip-asn-lite.mmdb
GEOIP_LOCATION_DB_PATH=data/geoip/dbip-city-lite.mmdb

# --- Contact form (Phase 4) ------------------------------------------------------
# Key for hashing IPs (rate-limit keys, contact_messages.ip_hash). Required, ≥ 32 characters.
# Fine for local development; production uses its own: openssl rand -hex 32
IP_HASH_SECRET=local-dev-only-ip-hash-secret-change-me-in-production
# POST /api/v1/contact accepts this many messages per sender per window, then answers 429.
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
# Worker: how to tell you about a new message. "log" writes a log line (no setup needed);
# "discord" posts to a channel webhook (Server Settings → Integrations → Webhooks → New Webhook
# → Copy Webhook URL). The URL is a secret: anyone who has it can post to your channel.
NOTIFIER_DRIVER=log
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Attempts per notification (including the first), and the first retry delay (it doubles).
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BACKOFF_BASE_MS=5000

# --- Observability and security (Phase 5) ------------------------------------------
# Browser origins allowed to call the API (the web app). Comma-separated, no trailing "/".
CORS_ORIGINS=http://localhost:3000
# Set to require `Authorization: Bearer <token>` on GET /metrics (≥ 16 characters).
# METRICS_TOKEN=

# --- Website (Phase 5) ---------------------------------------------------------------
# Next.js does not read this file. Its two variables default to the local API, so
# `npm run dev:web` needs nothing; to override, export them or put them in apps/web/.env.local:
#   API_BASE_URL=http://localhost:4000              (Next.js server → API, read per request)
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:4000  (browsers → API, baked in at `next build`)
